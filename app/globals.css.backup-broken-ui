@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  color-scheme: dark;
  --background: #030712;
  --foreground: #f8fafc;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  background-color: var(--background);
}

html,
body {
  margin: 0;
  padding: 0;
  min-height: 100%;
}

body {
  position: relative;
  overflow-x: hidden;
  background-color: var(--background);
  color: var(--foreground);
  font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: -2;
  opacity: 0.9;
  background:
    radial-gradient(900px circle at 10% -10%, rgba(34, 211, 238, 0.12), transparent 52%),
    radial-gradient(700px circle at 92% 8%, rgba(168, 85, 247, 0.1), transparent 48%),
    radial-gradient(600px circle at 50% 100%, rgba(249, 115, 22, 0.06), transparent 45%),
    linear-gradient(180deg, #030712 0%, #050816 50%, #020617 100%);
}

body::after {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: -1;
  opacity: 0.2;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.028) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.028) 1px, transparent 1px);
  background-size: 76px 76px;
  mask-image: radial-gradient(ellipse 80% 55% at 50% -5%, black 0%, transparent 72%);
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea,
select {
  font: inherit;
}

@keyframes noaerth-fade-up {
  from {
    opacity: 0;
    transform: translateY(16px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.motion-fade-up {
  animation: noaerth-fade-up 0.75s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@media (prefers-reduced-motion: reduce) {
  .motion-fade-up {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
}

::-webkit-scrollbar {
  width: 9px;
}

::-webkit-scrollbar-track {
  background: rgba(15, 23, 42, 0.92);
}

::-webkit-scrollbar-thumb {
  background: rgba(34, 211, 238, 0.32);
  border-radius: 999px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(168, 85, 247, 0.45);
}

html {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  scroll-behavior: smooth;
}

body {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  background: #050816;
  color: #ffffff;
  text-rendering: geometricPrecision;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

main {
  width: 100%;
  max-width: 100vw;
  overflow-x: hidden;
}

section {
  position: relative;
}

img,
svg,
video,
canvas {
  max-width: 100%;
  height: auto;
}

a,
button {
  -webkit-tap-highlight-color: transparent;
}

* {
  min-width: 0;
}

@media (max-width: 768px) {
  h1 {
    font-size: clamp(3rem, 14vw, 4.5rem) !important;
    line-height: 0.95 !important;
    letter-spacing: -0.06em !important;
  }

  h2 {
    font-size: clamp(2rem, 9vw, 3.25rem) !important;
    line-height: 1.02 !important;
    letter-spacing: -0.045em !important;
  }

  p {
    max-width: 100%;
  }

  header nav {
    display: none !important;
  }

  header > div {
    gap: 1rem;
  }

  header a:last-child {
    white-space: nowrap;
    padding-left: 0.875rem;
    padding-right: 0.875rem;
  }

  .grid {
    grid-template-columns: 1fr !important;
  }

  [class*="min-h-[88vh]"] {
    min-height: auto !important;
  }

  [class*="py-20"] {
    padding-top: 4rem !important;
    padding-bottom: 4rem !important;
  }

  [class*="pt-24"] {
    padding-top: 5rem !important;
  }

  [class*="pt-32"] {
    padding-top: 5rem !important;
  }

  [class*="pb-24"] {
    padding-bottom: 4rem !important;
  }

  [class*="p-10"] {
    padding: 1.5rem !important;
  }

  [class*="p-8"] {
    padding: 1.25rem !important;
  }

  [class*="rounded-[2rem]"] {
    border-radius: 1.5rem !important;
  }

  [class*="rounded-[1.75rem]"] {
    border-radius: 1.25rem !important;
  }
}

@media (max-width: 420px) {
  h1 {
    font-size: clamp(2.5rem, 13vw, 3.5rem) !important;
  }

  h2 {
    font-size: clamp(1.85rem, 8vw, 2.75rem) !important;
  }

  [class*="px-6"] {
    padding-left: 1rem !important;
    padding-right: 1rem !important;
  }

  [class*="gap-14"] {
    gap: 2rem !important;
  }

  [class*="gap-8"] {
    gap: 1.25rem !important;
  }

  [class*="gap-6"] {
    gap: 1rem !important;
  }
}
